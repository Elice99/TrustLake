# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
# Used directly by the postgres service, and to construct DATABASE_URL below.
POSTGRES_USER=trustlake
POSTGRES_PASSWORD=Elicebassey1995
POSTGRES_DB=trustlake

# --- API ---
# Must match the Postgres values above. Host is "postgres" (the Compose
# service name), not "localhost" — containers reach each other by service
# name on the Docker Compose network.
#
# Note: uses postgresql+asyncpg:// (not plain postgresql://) as of
# Stage 2 — the backend uses SQLAlchemy's async engine, which requires
# an explicit driver in the URL scheme. If you're updating from a
# Stage 0 .env, you need to add "+asyncpg" here.
DATABASE_URL=postgresql+asyncpg://trustlake:Elicebassey1995@postgres:5432/trustlake
